# ---------------------------------------------------------------------------
# Supabase Postgres connection — copy to `.env` and fill in real values.
# ---------------------------------------------------------------------------
# LOCAL DEV (IPv4 networks): Session pooler — IPv4-proxied.
#   host: aws-0-<region>.pooler.supabase.com  port: 5432  user: postgres.<project-ref>
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# PRODUCTION (IPv6-capable hosts, e.g. the Hetzner VPS): Direct connection.
#   host: db.<project-ref>.supabase.co  port: 5432  user: postgres
# DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# App-side connection pool size. Keep under your Supabase compute tier's cap.
DB_POOL_MAX=10

# One backend deployment indexes one network. Run separate instances for
# mainnet and testnet so data and signed quotes can never cross chains.
ABEY_NETWORK=testnet
ABEY_TESTNET_RPC_URL=https://testrpc.abeychain.com
ABEY_MAINNET_RPC_URL=https://rpc.abeychain.com
PORT=8788
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://0.0.0.0:5173

# Use a dedicated hot key whose address has been set as priceSigner on the
# selected registrar. Never place the contract-owner/deployer key here.
# ANS_PRICE_SIGNER_PRIVATE_KEY=0x...
# Optional test-only wallet charged 1% of standard ANS prices on chain 178.
# ANS_TESTNET_ADMIN_WALLET=0x...
ANS_PRICE_QUOTE_TTL_SECONDS=300
ABEY_PRICE_SOURCE_URL=https://api.coingecko.com/api/v3/simple/price?ids=abey&vs_currencies=usd
ABEY_PRICE_FALLBACK_USD=0.01477813
ABEY_PRICE_SOURCE_REFRESH_INTERVAL_MS=60000
ANS_SYNC_INTERVAL_SECONDS=60
ANS_SYNC_CHUNK_SIZE=10
# Recent registrar/registry/resolver events are indexed before historical backfill.
ANS_REALTIME_LOOKBACK_BLOCKS=250
# Bound old-history work so a sync completes and recent registrations stay fresh.
ANS_HISTORICAL_CHUNKS_PER_RUN=10
